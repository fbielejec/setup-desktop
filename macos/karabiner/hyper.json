{
  "title": "setup-desktop",
  "rules": [
    {
      "description": "Caps Lock -> Hyper (ctrl+alt+cmd) for AeroSpace; tapped alone -> Escape",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_control",
              "modifiers": ["left_option", "left_command"]
            }
          ],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    }
  ]
}
